{% assign paper_heading = 'h2' %}
{% if include.compact %}{% assign paper_heading = 'h3' %}{% endif %}
<ol class="academic-records">
  {% for paper in include.papers %}
    <li id="{{ paper.id | escape }}">
      <{{ paper_heading }}>{{ paper.title | escape }}{% if paper.paper_url %}
        <a class="academic-paper-link" href="{{ paper.paper_url | escape }}">Paper</a>
      {% endif %}</{{ paper_heading }}>
      <p class="academic-authors">
        {% for author in paper.authors -%}
          {%- if author.highlight -%}<strong>{{ author.name | escape }}</strong>
          {%- else -%}{{ author.name | escape }}{%- endif -%}
          {%- unless forloop.last -%}, {% endunless -%}
        {%- endfor %}
      </p>
      <p class="academic-venue">
        {% assign conference_year = paper.venue_year | default: paper.publication_year %}
        {% if paper.abbreviation or conference_year %}
          <strong class="academic-conference">{{ paper.abbreviation | escape }}{% if paper.abbreviation and conference_year %}&nbsp;{% endif %}{{ conference_year }}</strong>
        {% endif %}
        <span>{{ paper.venue | escape }}</span>
        {% if paper.status %}<span class="academic-status">{{ paper.status | escape }}</span>{% endif %}
      </p>
    </li>
  {% endfor %}
</ol>
